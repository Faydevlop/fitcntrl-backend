  "private": true,
  "main": "dist/server.js",
  "scripts": {
    "dev": "nodemon --watch \"src/**\" --watch \".env\" --ext \"ts\" --exec \"ts-node\" src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "bullmq": "^5.12.12",
    "cors": "^2.8.5",
