NODE_ENV=development
SERVICE_NAME=fitcntrl-automation-service
LOG_LEVEL=info
PORT=4001
API_PREFIX=/api
MONGO_URI=mongodb://localhost:27017/gym_management
REDIS_URL=redis://localhost:6379
WHATSAPP_WEBHOOK_VERIFY_TOKEN=replace_verify_token
JWT_SECRET=replace_with_strong_secret
DATA_ENCRYPTION_KEY=replace_with_shared_encryption_key
INTERNAL_API_TOKEN=replace_with_internal_service_token
WHATSAPP_GRAPH_API_BASE_URL=https://graph.facebook.com/v24.0
CORS_ALLOWLIST=http://localhost:5173
RATE_LIMIT_WINDOW_MS=300000
RATE_LIMIT_MAX=1200
